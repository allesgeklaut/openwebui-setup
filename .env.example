# ============================================================================
# Open WebUI Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Credentials belong in /opt/secrets, not this file. WEBUI_SECRET_KEY,
# OPEN_TERMINAL_API_KEY and OAUTH_CLIENT_ID/SECRET are loaded from webui.env;
# the Trilium token is read from trilium.token by start.sh.
# ============================================================================

# IP of the host running the companion stacks (Ollama, ComfyUI,
# SearXNG). Referenced by the *_URL values below via ${LAN_IP}.
LAN_IP=<your-LAN-IP>

# --------------------------------------------------------------------------
# Trilium MCP Server (Optional)
# Used by mcpo over the shared trilium_default Docker network
# --------------------------------------------------------------------------
TRILIUM_URL=http://trilium:8080/etapi

# --------------------------------------------------------------------------
# Ollama / OpenAI API Configuration
# Base URLs for LLM inference
# --------------------------------------------------------------------------
OLLAMA_BASE_URL=http://${LAN_IP}:11434
# OpenAI-compatible endpoint via LiteLLM proxy (routes to llama.cpp w/ idle-stop)
OPENAI_API_BASE_URL=http://${LAN_IP}:4000/v1

# --------------------------------------------------------------------------
# OpenID Provider Configuration
# Cloudflare Access OIDC configuration URL and redirect URI
# --------------------------------------------------------------------------
OPENID_PROVIDER_URL=https://your-domain.cloudflareaccess.com/cdn-cgi/access/sso/oidc/{id}/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://your-domain.tld/oauth/oidc/callback

# --------------------------------------------------------------------------
# Mistral Web Scout agent (research-search)
# The "Web Scout" Mistral Studio agent id that backs web search + fetch.
# --------------------------------------------------------------------------
SCOUT_AGENT_ID=your_web_scout_agent_id

# --------------------------------------------------------------------------
# SearXNG Configuration
# The session-signing secret is NOT a .env var anymore: it lives in
# /opt/secrets/searxng.secret (the repo's one-place secrets convention),
# mounted read-only into the container and exported as SEARXNG_SECRET by
# searxng/config/entrypoint-wrapper.sh at startup (SearXNG's schema
# overrides server.secret_key from that env var).
# Generate with: (umask 077; openssl rand -hex 32 > /opt/secrets/searxng.secret)
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Audiobookshelf MCP
# Comma-separated native library IDs; keep your actual IDs in the ignored .env.
# The connector requires a non-empty allowlist. Podcast writes remain enabled
# in compose.yml; this setting does not change that opt-in.
# --------------------------------------------------------------------------
ABS_ALLOWED_LIBRARY_IDS=your_audiobookshelf_library_id

# --------------------------------------------------------------------------
# Image Generation & Editing (ComfyUI)
# Open WebUI's native ComfyUI engine talks directly to ComfyUI's /prompt
# and websocket endpoints. Both generation and editing use the local
# ComfyUI stack (Qwen-Image-2.1), reached through the lifecycle proxy in the
# litellm stack (it starts comfyui on demand and stops it when idle).
# NOTE: the persisted images.*.comfyui.base_url values in the Open WebUI
# config DB override this default. The workflows + per-node mappings live in
# that DB too; see workflows/ and the "Image generation & editing" section of
# README.md.
# --------------------------------------------------------------------------
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=comfyui
COMFYUI_BASE_URL=http://${LAN_IP}:8189
# COMFYUI_API_KEY=  # leave empty unless you front ComfyUI with auth

# --------------------------------------------------------------------------
# RunPod serverless ComfyUI bridge (optional)
# The runpod-bridge service exposes a ComfyUI-compatible API and forwards
# jobs to the RunPod serverless endpoint (worker-comfyui). It is retained
# but NOT used by default: local ComfyUI above serves both generation and
# editing. To use it, point image_generation.comfyui.base_url (and/or
# images.edit.comfyui.base_url) at http://runpod-bridge:8190 in the Open
# WebUI config.
# --------------------------------------------------------------------------
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
# Optional dedicated endpoint for image EDIT jobs (e.g. a FLUX.1-Kontext
# worker). Leave empty to route edit jobs to the generation endpoint.
RUNPOD_ENDPOINT_ID_EDIT=

# --------------------------------------------------------------------------
# Notes:
# - All URLs should point to your local network IP (e.g., 192.168.x.x)
# - WEBUI_SECRET_KEY: Generate with `openssl rand -hex 32` or similar
# - OAUTH_CLIENT_ID/SECRET: Get from Cloudflare Access dashboard
# - TRILIUM_API_KEY: From Trilium note-taking app settings
# ============================================================================
