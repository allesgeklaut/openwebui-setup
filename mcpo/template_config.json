{
  "mcpServers": {
    "filesystem": {
      "command": "/bin/sh",
      "args": [
        "/stacks/webui/mcpo/run-npx.sh",
        "@modelcontextprotocol/server-filesystem",
        "/stacks"
      ]
    },
    "trilium": {
      "command": "/bin/sh",
      "args": [
        "/stacks/webui/mcpo/run-npx.sh",
        "triliumnext-mcp"
      ],
      "env": {
        "TRILIUM_API_URL": "${TRILIUM_URL}",
        "TRILIUM_API_TOKEN": "${TRILIUM_API_KEY}"
      }
    },
    "searxng": {
      "command": "/bin/sh",
      "args": [
        "/stacks/webui/mcpo/run-npx.sh",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://searxng:8080"
      }
    },
    "trainlocks": {
      "command": "uvx",
      "args": [
        "--with-requirements",
        "/stacks/webui/mcpo/requirements.txt",
        "python",
        "/stacks/webui/mcpo/trainlocks/trainlocks_mcp_server.py"
      ],
      "env": {
        "TRAINLOGS_URL": "http://training-log:8000",
        "TRAINLOGS_USERNAME": "${TRAINLOGS_USERNAME}",
        "TRAINLOGS_PASSWORD": "${TRAINLOGS_PASSWORD}"
      }
    },
    "deep-research": {
      "command": "uvx",
      "args": [
        "--with-requirements",
        "/stacks/webui/mcpo/requirements.txt",
        "python",
        "/stacks/webui/mcpo/deep-research/deep_research_mcp_server.py"
      ],
      "env": {
        "MISTRAL_API_KEY": "${MISTRAL_API_KEY}",
        "DEEP_RESEARCH_AGENT_ID": "${DEEP_RESEARCH_AGENT_ID}"
      }
    }
  }
}
