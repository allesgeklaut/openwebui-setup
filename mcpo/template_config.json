{
  "mcpServers": {
    "filesystem": {
      "command": "/usr/bin/npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/stacks"
      ]
    },
    "trilium": {
      "command": "npx",
      "args": ["-y", "triliumnext-mcp"],
      "env": {
        "TRILIUM_API_URL": "${TRILIUM_URL}",
        "TRILIUM_API_TOKEN": "${TRILIUM_API_KEY}"
      }
    },
    "portainer": {
      "command": "uvx",
      "args": [
        "--with", "fastmcp",
        "--with", "httpx",
        "python",
        "/stacks/webui/mcpo/portainer/portainer_mcp_server.py"
      ],
      "env": {
        "PORTAINER_URL": "https://<your-LAN-IP>:9443",
        "PORTAINER_API_KEY": "${PORTAINER_API_KEY}",
        "PORTAINER_ENV_ID": "${PORTAINER_ENV_ID}"
      }
    },
    "searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://searxng:8080"
      }
    },
    "trainlocks": {
      "command": "uvx",
      "args": [
        "--with", "fastmcp",
        "--with", "httpx",
        "python",
        "/stacks/webui/mcpo/trainlocks/trainlocks_mcp_server.py"
      ],
      "env": {
        "TRAINLOGS_URL": "http://training-log:8000",
        "TRAINLOGS_USERNAME": "${TRAINLOGS_USERNAME}",
        "TRAINLOGS_PASSWORD": "${TRAINLOGS_PASSWORD}"
      }
    }
  }
}
